// Erota Sales Intelligence — data model (PostgreSQL)
// Structured payloads stay as JSON strings with typed helpers in src/lib/types.ts
// so the app stays portable; columns can move to Prisma Json later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  // Ingestion + sampling policy (JSON: IngestionPolicy in src/lib/types.ts)
  ingestionPolicyJson  String    @default("{}")
  audioRetentionDays   Int       @default(90)
  dataRetentionDays    Int       @default(365)
  webhookSecret        String    @default(cuid())
  activeMethodologyId  String?
  onboardingComplete   Boolean   @default(false)
  planStatus           String    @default("trialing") // trialing | active | past_due | canceled | unpaid
  planKey              String    @default("trial") // trial | pro | max | enterprise
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeSeatCount      Int       @default(1)
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Shareable join link. Null when disabled; anyone with the code joins as REP
  // while seats remain.
  joinCode             String?   @unique

  // Platform suspension. Independent of Stripe: a paused workspace keeps its
  // subscription and its data, and new AI Role Play / call review is refused.
  suspendedAt     DateTime?
  suspendedReason String    @default("")

  // Extra seconds granted by a platform owner, added on top of the plan cap.
  // Trial: shared by the workspace. Paid: added to each seat's monthly cap.
  bonusRoleplaySec   Int @default(0)
  bonusCallReviewSec Int @default(0)

  // Complimentary entitlement. Never written into planKey / planStatus / Stripe
  // columns. Ignored while a paid subscription is still entitled.
  compPlanKey   String?
  compExpiresAt DateTime?
  compReason    String    @default("")

  users          User[]
  invites        Invite[]
  methodologies  Methodology[]
  companyContext CompanyContext?
  calls          Call[]
  scenarios      Scenario[]
  roleplays      RoleplaySession[]
  grades         Grade[]
  assignments    Assignment[]
  signupEvents   SignupEvent[]
  billingEvents  BillingEvent[]
  adminAudits    AdminAudit[]

  createdAt DateTime @default(now())
}

model User {
  id      String  @id @default(cuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id])
  clerkId String? @unique

  name      String
  email     String    @unique
  role      String // REP | MANAGER | TRAINER | ADMIN
  title     String    @default("")
  // Soft removal: history stays attributed, access and seat usage end.
  removedAt DateTime?

  calls        Call[]            @relation("RepCalls")
  roleplays    RoleplaySession[]
  assignments  Assignment[]      @relation("AssignedTo")
  assignedById Assignment[]      @relation("AssignedBy")
  sentInvites  Invite[]          @relation("InvitedBy")

  createdAt DateTime @default(now())

  @@index([orgId])
}

// A pending seat in an org. Accepted when a Clerk user with the matching
// (verified) email first signs in, or when a signed-in user opens the link.
model Invite {
  id                String    @id @default(cuid())
  orgId             String
  org               Org       @relation(fields: [orgId], references: [id])
  email             String
  role              String    @default("REP")
  token             String    @unique @default(cuid())
  status            String    @default("pending") // pending | accepted | revoked
  invitedById       String?
  invitedBy         User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  // Clerk invitation id when Clerk delivered the email; null when link-only.
  clerkInvitationId String?
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedUserId    String?
  createdAt         DateTime  @default(now())

  @@index([orgId, status])
  @@index([email, status])
}

// A methodology is a rubric: a set of weighted, scored dimensions.
model Methodology {
  id    String  @id @default(cuid())
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  name           String
  description    String  @default("")
  isPreset       Boolean @default(false)
  // JSON: RubricDimension[] (src/lib/types.ts)
  dimensionsJson String

  grades    Grade[]
  scenarios Scenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Everything the customer tells us about their business. Grounds grading
// feedback and role-play persona generation.
model CompanyContext {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id])

  // JSON: CompanyProfile (src/lib/types.ts): description, products, personas,
  // objections (with approved responses), competitors, talkTracks, valueProps
  profileJson String @default("{}")

  updatedAt DateTime @updatedAt
}

model Call {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation("RepCalls", fields: [repId], references: [id])

  source       String // UPLOAD | WEBHOOK | API | DIALER
  direction    String  @default("outbound") // outbound | inbound
  callType     String  @default("unknown") // cold_call | discovery | demo | negotiation | renewal | unknown
  durationSec  Int     @default(0)
  externalId   String? // provider call id, used for dedup
  // local:uploads/... or s3:object-key
  audioPath    String?
  prospectName String  @default("")

  status         String  @default("INGESTED") // INGESTED | SKIPPED | QUEUED | TRANSCRIBING | GRADING | GRADED | FAILED
  // Why this call was (not) graded under the sampling policy:
  // SAMPLED | NOT_SAMPLED | BELOW_MIN_DURATION | MANUAL_UPLOAD | REP_FLAGGED | MANAGER_REQUESTED | WITHIN_THRESHOLD
  samplingStatus String  @default("NOT_SAMPLED")
  failReason     String?

  // Call-review metering (see src/lib/usage.ts). One reservation per call:
  // NONE (not metered yet) | RESERVED (processing in flight) | SETTLED (counts
  // against the allowance) | RELEASED (processing failed; nothing charged).
  // Retries and duplicate jobs reuse the same row, so a call is charged once.
  meterStatus    String    @default("NONE")
  meteredSec     Int       @default(0)
  // True when the metered length was estimated from a transcript rather
  // than taken from a recording or timestamps.
  meterEstimated Boolean   @default(false)
  meteredAt      DateTime?

  transcript Transcript?
  grade      Grade?

  callDate  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([orgId, externalId])
  @@index([orgId, repId, callDate])
  @@index([orgId, meterStatus])
}

model Transcript {
  id     String @id @default(cuid())
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  // JSON: TranscriptSegment[] ({ speaker: "rep"|"prospect", startSec, endSec, text })
  segmentsJson String
  fullText     String
  engine       String @default("mock") // deepgram | whisper | provided | mock

  createdAt DateTime @default(now())
}

model Scenario {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  title             String
  callType          String @default("discovery")
  difficulty        String @default("medium") // easy | medium | hard
  // JSON: ScenarioPersona (src/lib/types.ts)
  personaJson       String
  // JSON: string[] — what a winning conversation accomplishes
  winConditionsJson String @default("[]")

  methodologyId String?
  methodology   Methodology? @relation(fields: [methodologyId], references: [id])

  roleplays   RoleplaySession[]
  assignments Assignment[]

  createdAt DateTime @default(now())
}

model RoleplaySession {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation(fields: [repId], references: [id])

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  mode         String    @default("TEXT") // TEXT | VOICE
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | GRADED | FAILED
  // JSON: RoleplayMessage[] ({ role: "rep"|"prospect", text, atMs })
  messagesJson String    @default("[]")
  vapiCallId   String?
  // Billed seconds. Settled incrementally from liveness heartbeats while the
  // session is active, so setup time and abandoned sessions are not charged.
  durationSec  Int       @default(0)
  // Last liveness signal from the client (token mint, transcript sync, message).
  // Null once the session has ended.
  meteredAt    DateTime?

  grade Grade?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([orgId, repId, startedAt])
  @@index([orgId, status])
}

model Grade {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  subjectType String // CALL | ROLEPLAY
  callId      String?          @unique
  call        Call?            @relation(fields: [callId], references: [id])
  roleplayId  String?          @unique
  roleplay    RoleplaySession? @relation(fields: [roleplayId], references: [id])

  methodologyId String
  methodology   Methodology @relation(fields: [methodologyId], references: [id])

  // JSON: DimensionScore[] ({ key, score 1..5, rationale, quotes })
  dimensionScoresJson String
  overallScore        Int // 0..100, weighted rollup — see src/lib/scoring.ts
  band                String // exceptional | strong | developing | needs_coaching
  // JSON: string[]
  strengthsJson       String @default("[]")
  improvementsJson    String @default("[]")
  summary             String @default("")
  // JSON: Mechanics ({ talkRatio, questionCount, longestMonologueSec, fillerWords, interruptions })
  mechanicsJson       String @default("{}")
  gradedBy            String @default("mock") // model id, or "mock"

  // Manager calibration layer
  managerOverrideScore Int?
  managerComment       String?

  createdAt DateTime @default(now())

  @@index([orgId, subjectType, createdAt])
}

model Assignment {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  type        String // ROLEPLAY | UPLOAD_CALLS
  scenarioId  String?
  scenario    Scenario? @relation(fields: [scenarioId], references: [id])
  targetCount Int       @default(1)
  doneCount   Int       @default(0)
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, assignedToId, status])
}

// Marketing site demo / Google Ads lead capture
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String   @default("")
  source    String   @default("website")
  createdAt DateTime @default(now())

  @@index([email])
}

// Immutable signup funnel record — identity (Clerk) + tenant (Org/User) + attribution.
// Status advances: signed_up → provisioned → activated → converted (Stripe, Phase 1).
// Who changed a workspace from the platform dashboard, and what changed.
// Actor identity comes from Clerk on the server. No secrets, transcripts, or recordings.
model AdminAudit {
  id           String   @id @default(cuid())
  actorClerkId String
  actorEmail   String
  orgId        String?
  org          Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  action       String
  reason       String   @default("")
  beforeJson   String   @default("{}")
  afterJson    String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([createdAt])
}

model SignupEvent {
  id          String @id @default(cuid())
  clerkUserId String
  email       String
  name        String @default("")

  // How we learned about them
  source String @default("clerk_webhook") // clerk_webhook | first_login | invite

  // Funnel status
  status String @default("signed_up") // signed_up | provisioned | activated | converted | churned

  // Attribution (from landing cookie / UTM)
  utmSource   String @default("")
  utmMedium   String @default("")
  utmCampaign String @default("")
  utmContent  String @default("")
  utmTerm     String @default("")
  referrer    String @default("")
  landingPath String @default("")

  // Linked tenant once provisioned
  orgId  String?
  org    Org?    @relation(fields: [orgId], references: [id])
  userId String?

  // Optional link to a prior marketing Lead row
  leadId String?

  signedUpAt    DateTime  @default(now())
  provisionedAt DateTime?
  activatedAt   DateTime?
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([clerkUserId])
  @@index([email])
  @@index([status, signedUpAt])
  @@index([utmSource, utmCampaign])
}

// Stripe webhook inbox. stripeEventId is unique, making webhook processing
// idempotent when Stripe retries delivery.
model BillingEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  orgId         String?
  org           Org?     @relation(fields: [orgId], references: [id])
  processedAt   DateTime @default(now())

  @@index([orgId, processedAt])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
