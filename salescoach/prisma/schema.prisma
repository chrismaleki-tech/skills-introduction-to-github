// SalesCoach AI — data model
// NOTE ON JSON COLUMNS: SQLite (dev database) does not support Prisma's Json
// type, so structured payloads are stored as JSON strings. Typed parse/serialize
// helpers live in src/lib/types.ts. The schema is otherwise Postgres-portable:
// switch the datasource provider and migrate String json columns to Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Org {
  id                  String  @id @default(cuid())
  name                String
  // Ingestion + sampling policy (JSON: IngestionPolicy in src/lib/types.ts)
  ingestionPolicyJson String  @default("{}")
  webhookSecret       String  @default(cuid())
  activeMethodologyId String?

  users          User[]
  methodologies  Methodology[]
  companyContext CompanyContext?
  calls          Call[]
  scenarios      Scenario[]
  roleplays      RoleplaySession[]
  grades         Grade[]
  assignments    Assignment[]
  accounts       Account[]
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  connections    ChannelConnection[]
  conversations  Conversation[]
  messages       Message[]
  products       Product[]
  vendors        Vendor[]
  quotes         Quote[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
}

model User {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  name  String
  email String @unique
  role  String // REP | MANAGER | TRAINER | ADMIN
  title String @default("")

  calls          Call[]            @relation("RepCalls")
  roleplays      RoleplaySession[]
  assignments    Assignment[]      @relation("AssignedTo")
  assignedById   Assignment[]      @relation("AssignedBy")
  ownedDeals     Deal[]            @relation("DealOwner")
  ownedAccounts  Account[]         @relation("AccountOwner")
  ownedContacts  Contact[]         @relation("ContactOwner")
  activities     Activity[]        @relation("ActivityOwner")
  connections    ChannelConnection[]
  conversations  Conversation[]    @relation("ConversationOwner")
  messages       Message[]         @relation("MessageSender")
  quotes         Quote[]           @relation("QuoteOwner")
  salesOrders    SalesOrder[]      @relation("OrderOwner")
  invoices       Invoice[]         @relation("InvoiceOwner")
  payments       Payment[]         @relation("PaymentRecorder")
  purchaseOrders PurchaseOrder[]   @relation("PoOwner")

  createdAt DateTime @default(now())
}

// A methodology is a rubric: a set of weighted, scored dimensions.
model Methodology {
  id    String  @id @default(cuid())
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  name        String
  description String @default("")
  isPreset    Boolean @default(false)
  // JSON: RubricDimension[] (src/lib/types.ts)
  dimensionsJson String

  grades    Grade[]
  scenarios Scenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Everything the customer tells us about their business. Grounds grading
// feedback and role-play persona generation.
model CompanyContext {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id])

  // JSON: CompanyProfile (src/lib/types.ts): description, products, personas,
  // objections (with approved responses), competitors, talkTracks, valueProps
  profileJson String @default("{}")

  updatedAt DateTime @updatedAt
}

model Call {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation("RepCalls", fields: [repId], references: [id])

  source       String // UPLOAD | WEBHOOK | API | DIALER | CRM
  direction    String @default("outbound") // outbound | inbound
  callType     String @default("unknown") // cold_call | discovery | demo | negotiation | renewal | unknown
  durationSec  Int    @default(0)
  externalId   String? // provider call id, used for dedup
  audioPath    String? // stored audio file (local uploads dir in dev)
  prospectName String @default("")

  // Optional CRM links — graded coaching feedback writes back to the deal timeline.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  status String @default("INGESTED") // INGESTED | SKIPPED | QUEUED | TRANSCRIBING | GRADING | GRADED | FAILED
  // Why this call was (not) graded under the sampling policy:
  // SAMPLED | NOT_SAMPLED | BELOW_MIN_DURATION | MANUAL_UPLOAD | REP_FLAGGED | MANAGER_REQUESTED | WITHIN_THRESHOLD
  samplingStatus String @default("NOT_SAMPLED")
  failReason     String?

  transcript Transcript?
  grade      Grade?
  activities Activity[]
  messages   Message[]

  callDate  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([orgId, repId, callDate])
  @@index([orgId, dealId])
  @@unique([orgId, externalId])
}

// ---------- CRM (accounts / contacts / deals) ----------
// Lives in the same tenant as coaching so deal stage context can ground grades
// and scorecards can write back onto the deal timeline.

model Account {
  id      String  @id @default(cuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id])
  ownerId String?
  owner   User?   @relation("AccountOwner", fields: [ownerId], references: [id])

  name     String
  domain   String  @default("")
  industry String  @default("")
  size     String  @default("") // e.g. "50-200"
  website  String  @default("")
  notes    String  @default("")

  contacts   Contact[]
  deals      Deal[]
  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
}

model Contact {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  ownerId   String?
  owner     User?   @relation("ContactOwner", fields: [ownerId], references: [id])

  name   String
  email  String  @default("")
  phone  String  @default("")
  title  String  @default("")
  notes  String  @default("")

  deals      Deal[]
  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
  @@index([orgId, email])
}

model Deal {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("DealOwner", fields: [ownerId], references: [id])

  name   String
  // lead | qualified | discovery | demo | proposal | negotiation | closed_won | closed_lost
  stage  String @default("lead")
  amount Int    @default(0) // USD cents avoided — store whole dollars for demo simplicity
  // Product / line the deal is about (feeds coaching context)
  product     String @default("")
  probability Int    @default(10) // 0..100
  nextStep    String @default("")
  notes       String @default("")
  closeDate   DateTime?

  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, stage])
  @@index([orgId, ownerId])
}

model Activity {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  ownerId   String?
  owner     User?   @relation("ActivityOwner", fields: [ownerId], references: [id])
  callId    String?
  call      Call?    @relation(fields: [callId], references: [id])

  // NOTE | CALL | EMAIL | MEETING | TASK | COACHING | QUOTE | ORDER | INVOICE | PAYMENT | PO
  type        String
  subject     String
  body        String  @default("")
  // For COACHING activities written back from SalesCoach grades
  score       Int?
  band        String?
  externalRef String? // stable id for upsert (e.g. grade:<gradeId>, quote:<id>:sent)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([orgId, externalRef])
  @@index([orgId, dealId, occurredAt])
  @@index([orgId, accountId, occurredAt])
}

// ---------- ERP (catalog / quotes / orders / invoices / inventory / purchasing) ----------
// Replaces external ERP for sales ops: product catalog with stock, quote→order→invoice
// flow tied to CRM deals, and light purchasing for replenishment. Document events write
// back to the deal timeline so coaching stays grounded in commercial reality.

model Product {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  sku         String
  name        String
  description String @default("")
  category    String @default("Software") // Software | Service | Hardware | Other
  // Whole dollars for demo simplicity (matches Deal.amount)
  listPrice   Int    @default(0)
  cost        Int    @default(0)
  unit        String @default("seat") // seat | license | warehouse | hour | each
  active      Boolean @default(true)
  trackInventory Boolean @default(false)
  qtyOnHand      Int     @default(0)
  qtyReserved    Int     @default(0)
  reorderPoint   Int     @default(0)

  quoteLines QuoteLine[]
  orderLines OrderLine[]
  invoiceLines InvoiceLine[]
  poLines    PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, sku])
  @@index([orgId, active])
  @@index([orgId, name])
}

model Vendor {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  name    String
  email   String @default("")
  phone   String @default("")
  website String @default("")
  notes   String @default("")

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
}

model Quote {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("QuoteOwner", fields: [ownerId], references: [id])

  // draft | sent | accepted | rejected | expired
  status    String @default("draft")
  title     String @default("")
  notes     String @default("")
  subtotal  Int    @default(0)
  taxRate   Int    @default(0) // percent whole number, e.g. 8 = 8%
  taxAmount Int    @default(0)
  total     Int    @default(0)
  validUntil DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?

  lines  QuoteLine[]
  orders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([quoteId])
}

model SalesOrder {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  quoteId   String?
  quote     Quote?  @relation(fields: [quoteId], references: [id])
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("OrderOwner", fields: [ownerId], references: [id])

  // pending | confirmed | fulfilled | cancelled
  status    String @default("pending")
  notes     String @default("")
  subtotal  Int    @default(0)
  taxRate   Int    @default(0)
  taxAmount Int    @default(0)
  total     Int    @default(0)
  orderedAt DateTime @default(now())
  fulfilledAt DateTime?

  lines    OrderLine[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model OrderLine {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([orderId])
}

model Invoice {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  orderId   String?
  order     SalesOrder? @relation(fields: [orderId], references: [id])
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("InvoiceOwner", fields: [ownerId], references: [id])

  // draft | sent | partial | paid | void
  status      String @default("draft")
  notes       String @default("")
  subtotal    Int    @default(0)
  taxRate     Int    @default(0)
  taxAmount   Int    @default(0)
  total       Int    @default(0)
  amountPaid  Int    @default(0)
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?

  lines    InvoiceLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([invoiceId])
}

model Payment {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedById String?
  recordedBy   User? @relation("PaymentRecorder", fields: [recordedById], references: [id])

  amount      Int
  method      String @default("ach") // ach | card | check | wire | other
  reference   String @default("")
  notes       String @default("")
  receivedAt  DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([orgId, receivedAt])
  @@index([invoiceId])
}

model PurchaseOrder {
  id       String  @id @default(cuid())
  orgId    String
  org      Org     @relation(fields: [orgId], references: [id])
  number   String
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  ownerId  String?
  owner    User?   @relation("PoOwner", fields: [ownerId], references: [id])

  // draft | submitted | received | cancelled
  status    String @default("draft")
  notes     String @default("")
  subtotal  Int    @default(0)
  total     Int    @default(0)
  orderedAt DateTime @default(now())
  receivedAt DateTime?

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, vendorId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitCost    Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([purchaseOrderId])
}

// ---------- Channels: employee email + phone connected for CRM outreach ----------
// Demo mode stores a connected address/number without real OAuth; production would
// swap provider tokens for Gmail/Outlook/Twilio/Aircall.

model ChannelConnection {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // EMAIL | PHONE
  channel  String
  // gmail | outlook | work_smtp | demo_email | twilio | aircall | ringcentral | demo_phone
  provider String
  // Email address or E.164 phone number shown as the "from"
  address  String
  // CONNECTED | DISCONNECTED | ERROR
  status   String @default("CONNECTED")
  // Opaque token blob for real providers (JSON string). Demo stores "{}".
  credentialsJson String @default("{}")
  lastError       String @default("")

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, channel])
  @@index([orgId, userId])
}

// A thread of emails or a phone conversation attached to CRM records.
model Conversation {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  ownerId   String
  owner     User    @relation("ConversationOwner", fields: [ownerId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  // EMAIL | PHONE
  channel String
  subject String @default("")
  // OPEN | CLOSED
  status  String @default("OPEN")
  // Prospect-facing address/number for this thread
  prospectAddress String @default("")

  messages Message[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([orgId, dealId, lastMessageAt])
  @@index([orgId, contactId, lastMessageAt])
  @@index([orgId, ownerId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])
  // Optional link when a PHONE message was graded as a SalesCoach call
  callId         String?
  call           Call?        @relation(fields: [callId], references: [id])

  // OUTBOUND | INBOUND
  direction String
  // For email: subject line of this message; for phone: "Outbound call" etc.
  subject   String @default("")
  body      String @default("")
  // queued | sent | delivered | failed | received | completed
  status    String @default("sent")
  // From/to for audit (employee connected address ↔ prospect)
  fromAddress String @default("")
  toAddress   String @default("")
  durationSec Int?
  externalId  String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([conversationId, occurredAt])
  @@index([orgId, occurredAt])
}

model Transcript {
  id     String @id @default(cuid())
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  // JSON: TranscriptSegment[] ({ speaker: "rep"|"prospect", startSec, endSec, text })
  segmentsJson String
  fullText     String
  engine       String @default("mock") // deepgram | whisper | provided | mock

  createdAt DateTime @default(now())
}

model Scenario {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  title       String
  callType    String @default("discovery")
  difficulty  String @default("medium") // easy | medium | hard
  // JSON: ScenarioPersona (src/lib/types.ts)
  personaJson String
  // JSON: string[] — what a winning conversation accomplishes
  winConditionsJson String @default("[]")

  methodologyId String?
  methodology   Methodology? @relation(fields: [methodologyId], references: [id])

  roleplays   RoleplaySession[]
  assignments Assignment[]

  createdAt DateTime @default(now())
}

model RoleplaySession {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation(fields: [repId], references: [id])

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  mode   String @default("TEXT") // TEXT | VOICE
  status String @default("ACTIVE") // ACTIVE | COMPLETED | GRADED | FAILED
  // JSON: RoleplayMessage[] ({ role: "rep"|"prospect", text, atMs })
  messagesJson String @default("[]")
  vapiCallId   String?
  durationSec  Int    @default(0)

  grade Grade?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([orgId, repId, startedAt])
}

model Grade {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  subjectType String // CALL | ROLEPLAY
  callId      String? @unique
  call        Call?   @relation(fields: [callId], references: [id])
  roleplayId  String? @unique
  roleplay    RoleplaySession? @relation(fields: [roleplayId], references: [id])

  methodologyId String
  methodology   Methodology @relation(fields: [methodologyId], references: [id])

  // JSON: DimensionScore[] ({ key, score 1..5, rationale, quotes })
  dimensionScoresJson String
  overallScore        Int // 0..100, weighted rollup — see src/lib/scoring.ts
  band                String // exceptional | strong | developing | needs_coaching
  // JSON: string[]
  strengthsJson    String @default("[]")
  improvementsJson String @default("[]")
  summary          String @default("")
  // JSON: Mechanics ({ talkRatio, questionCount, longestMonologueSec, fillerWords, interruptions })
  mechanicsJson String @default("{}")
  gradedBy      String @default("mock") // model id, or "mock"

  // Manager calibration layer
  managerOverrideScore Int?
  managerComment       String?

  createdAt DateTime @default(now())

  @@index([orgId, subjectType, createdAt])
}

model Assignment {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  type        String // ROLEPLAY | UPLOAD_CALLS
  scenarioId  String?
  scenario    Scenario? @relation(fields: [scenarioId], references: [id])
  targetCount Int       @default(1)
  doneCount   Int       @default(0)
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, assignedToId, status])
}
