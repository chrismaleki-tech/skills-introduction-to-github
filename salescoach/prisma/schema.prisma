// SalesCoach AI — data model
// NOTE ON JSON COLUMNS: SQLite (dev database) does not support Prisma's Json
// type, so structured payloads are stored as JSON strings. Typed parse/serialize
// helpers live in src/lib/types.ts. The schema is otherwise Postgres-portable:
// switch the datasource provider and migrate String json columns to Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Org {
  id                  String  @id @default(cuid())
  name                String
  // Ingestion + sampling policy (JSON: IngestionPolicy in src/lib/types.ts)
  ingestionPolicyJson String  @default("{}")
  // Compliance / retention (JSON: RetentionPolicy in src/lib/types.ts)
  retentionPolicyJson String  @default("{}")
  webhookSecret       String  @default(cuid())
  activeMethodologyId String?

  // SaaS subscription plan (see PLANS in src/lib/billing.ts)
  plan         String @default("trial") // trial | starter | growth | scale
  billingEmail String @default("")

  // Per-tenant platform customization (JSON: Customization in src/lib/customization.ts)
  customizationJson String @default("{}")

  // ERP org defaults
  baseCurrency   String @default("USD") // ISO 4217
  defaultTaxCode String @default("US-CA") // TaxCode.code

  users          User[]
  methodologies  Methodology[]
  companyContext CompanyContext?
  calls          Call[]
  scenarios      Scenario[]
  roleplays      RoleplaySession[]
  grades         Grade[]
  assignments    Assignment[]
  accounts       Account[]
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  connections    ChannelConnection[]
  conversations  Conversation[]
  messages       Message[]
  products       Product[]
  vendors        Vendor[]
  quotes         Quote[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  taxCodes       TaxCode[]
  fxRates        FxRate[]
  warehouses     Warehouse[]
  inventoryBalances InventoryBalance[]
  stockTransfers StockTransfer[]
  glAccounts     GlAccount[]
  journalEntries JournalEntry[]
  employees      Employee[]
  projects       Project[]
  timeEntries    TimeEntry[]
  goodsReceipts  GoodsReceipt[]
  vendorBills    VendorBill[]
  unmatchedIngests UnmatchedIngest[]
  jobs           Job[]
  usageEvents    UsageEvent[]

  createdAt DateTime @default(now())
}

model User {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  name         String
  email        String  @unique
  // bcrypt hash; empty means demo-only switcher login until password is set
  passwordHash String  @default("")
  role         String // REP | MANAGER | TRAINER | ADMIN
  title        String  @default("")
  lastLoginAt  DateTime?
  // Set when an org admin deactivates the seat; blocks login and sessions.
  disabledAt   DateTime?

  calls          Call[]            @relation("RepCalls")
  roleplays      RoleplaySession[]
  assignments    Assignment[]      @relation("AssignedTo")
  assignedById   Assignment[]      @relation("AssignedBy")
  ownedDeals     Deal[]            @relation("DealOwner")
  ownedAccounts  Account[]         @relation("AccountOwner")
  ownedContacts  Contact[]         @relation("ContactOwner")
  activities     Activity[]        @relation("ActivityOwner")
  connections    ChannelConnection[]
  conversations  Conversation[]    @relation("ConversationOwner")
  messages       Message[]         @relation("MessageSender")
  quotes         Quote[]           @relation("QuoteOwner")
  salesOrders    SalesOrder[]      @relation("OrderOwner")
  invoices       Invoice[]         @relation("InvoiceOwner")
  payments       Payment[]         @relation("PaymentRecorder")
  purchaseOrders PurchaseOrder[]   @relation("PoOwner")
  employee       Employee?
  projectOwned   Project[]         @relation("ProjectOwner")
  timeEntries    TimeEntry[]       @relation("TimeEntryUser")
  approvedPos    PurchaseOrder[]   @relation("PoApprover")
  journalPosted  JournalEntry[]    @relation("JournalPoster")
  transfersMade  StockTransfer[]   @relation("TransferUser")
  resolvedUnmatched UnmatchedIngest[] @relation("UnmatchedResolver")

  createdAt DateTime @default(now())
}

// A methodology is a rubric: a set of weighted, scored dimensions.
model Methodology {
  id    String  @id @default(cuid())
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  name        String
  description String @default("")
  isPreset    Boolean @default(false)
  // JSON: RubricDimension[] (src/lib/types.ts)
  dimensionsJson String

  grades    Grade[]
  scenarios Scenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Everything the customer tells us about their business. Grounds grading
// feedback and role-play persona generation.
model CompanyContext {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id])

  // JSON: CompanyProfile (src/lib/types.ts): description, products, personas,
  // objections (with approved responses), competitors, talkTracks, valueProps
  profileJson String @default("{}")

  updatedAt DateTime @updatedAt
}

model Call {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation("RepCalls", fields: [repId], references: [id])

  source       String // UPLOAD | WEBHOOK | API | DIALER | CRM
  direction    String @default("outbound") // outbound | inbound
  callType     String @default("unknown") // cold_call | discovery | demo | negotiation | renewal | unknown
  durationSec  Int    @default(0)
  externalId   String? // provider call id, used for dedup
  audioPath    String? // stored audio file (local uploads dir in dev)
  prospectName String @default("")

  // Optional CRM links — graded coaching feedback writes back to the deal timeline.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  status String @default("INGESTED") // INGESTED | SKIPPED | QUEUED | TRANSCRIBING | GRADING | GRADED | FAILED
  // Why this call was (not) graded under the sampling policy:
  // SAMPLED | NOT_SAMPLED | BELOW_MIN_DURATION | MANUAL_UPLOAD | REP_FLAGGED | MANAGER_REQUESTED | WITHIN_THRESHOLD
  samplingStatus String @default("NOT_SAMPLED")
  failReason     String?

  transcript Transcript?
  grade      Grade?
  activities Activity[]
  messages   Message[]

  callDate  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([orgId, repId, callDate])
  @@index([orgId, dealId])
  @@unique([orgId, externalId])
}

// ---------- CRM (accounts / contacts / deals) ----------
// Lives in the same tenant as coaching so deal stage context can ground grades
// and scorecards can write back onto the deal timeline.

model Account {
  id      String  @id @default(cuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id])
  ownerId String?
  owner   User?   @relation("AccountOwner", fields: [ownerId], references: [id])

  name     String
  domain   String  @default("")
  industry String  @default("")
  size     String  @default("") // e.g. "50-200"
  website  String  @default("")
  notes    String  @default("")

  contacts   Contact[]
  deals      Deal[]
  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
}

model Contact {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  ownerId   String?
  owner     User?   @relation("ContactOwner", fields: [ownerId], references: [id])

  name   String
  email  String  @default("")
  phone  String  @default("")
  title  String  @default("")
  notes  String  @default("")

  deals      Deal[]
  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
  @@index([orgId, email])
}

model Deal {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("DealOwner", fields: [ownerId], references: [id])

  name   String
  // lead | qualified | discovery | demo | proposal | negotiation | closed_won | closed_lost
  stage  String @default("lead")
  amount Int    @default(0) // USD cents avoided — store whole dollars for demo simplicity
  // Product / line the deal is about (feeds coaching context)
  product     String @default("")
  probability Int    @default(10) // 0..100
  nextStep    String @default("")
  notes       String @default("")
  closeDate   DateTime?

  calls      Call[]
  activities Activity[]
  conversations Conversation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, stage])
  @@index([orgId, ownerId])
}

model Activity {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  ownerId   String?
  owner     User?   @relation("ActivityOwner", fields: [ownerId], references: [id])
  callId    String?
  call      Call?    @relation(fields: [callId], references: [id])

  // NOTE | CALL | EMAIL | MEETING | TASK | COACHING | QUOTE | ORDER | INVOICE | PAYMENT | PO
  type        String
  subject     String
  body        String  @default("")
  // For COACHING activities written back from SalesCoach grades
  score       Int?
  band        String?
  externalRef String? // stable id for upsert (e.g. grade:<gradeId>, quote:<id>:sent)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([orgId, externalRef])
  @@index([orgId, dealId, occurredAt])
  @@index([orgId, accountId, occurredAt])
}

// ---------- ERP (catalog / quotes / orders / invoices / inventory / purchasing) ----------
// Replaces external ERP for sales ops: product catalog with stock, quote→order→invoice
// flow tied to CRM deals, and light purchasing for replenishment. Document events write
// back to the deal timeline so coaching stays grounded in commercial reality.

model Product {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  sku         String
  name        String
  description String @default("")
  category    String @default("Software") // Software | Service | Hardware | Other
  // Whole dollars for demo simplicity (matches Deal.amount)
  listPrice   Int    @default(0)
  cost        Int    @default(0)
  unit        String @default("seat") // seat | license | warehouse | hour | each
  active      Boolean @default(true)
  trackInventory Boolean @default(false)
  qtyOnHand      Int     @default(0) // denormalized sum across warehouses for fast lists
  qtyReserved    Int     @default(0)
  reorderPoint   Int     @default(0)

  quoteLines QuoteLine[]
  orderLines OrderLine[]
  invoiceLines InvoiceLine[]
  poLines    PurchaseOrderLine[]
  balances   InventoryBalance[]
  transferLines StockTransferLine[]
  receiptLines  GoodsReceiptLine[]
  billLines     VendorBillLine[]
  projectTasks  ProjectTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, sku])
  @@index([orgId, active])
  @@index([orgId, name])
}

model Vendor {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  name     String
  email    String @default("")
  phone    String @default("")
  website  String @default("")
  notes    String @default("")
  currency String @default("USD")
  paymentTermsDays Int @default(30)

  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
}

model Quote {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("QuoteOwner", fields: [ownerId], references: [id])

  // draft | sent | accepted | rejected | expired
  status    String @default("draft")
  title     String @default("")
  notes     String @default("")
  currency  String @default("USD")
  fxRateToBase Int @default(10000) // rate * 10000 vs org base (10000 = 1.0)
  taxCode   String @default("")
  subtotal  Int    @default(0)
  taxRate   Int    @default(0) // percent whole number, e.g. 8 = 8%
  taxAmount Int    @default(0)
  total     Int    @default(0)
  validUntil DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?

  lines  QuoteLine[]
  orders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([quoteId])
}

model SalesOrder {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  quoteId   String?
  quote     Quote?  @relation(fields: [quoteId], references: [id])
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("OrderOwner", fields: [ownerId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  // pending | confirmed | fulfilled | cancelled
  status    String @default("pending")
  notes     String @default("")
  currency  String @default("USD")
  fxRateToBase Int @default(10000)
  taxCode   String @default("")
  subtotal  Int    @default(0)
  taxRate   Int    @default(0)
  taxAmount Int    @default(0)
  total     Int    @default(0)
  orderedAt DateTime @default(now())
  fulfilledAt DateTime?

  lines    OrderLine[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model OrderLine {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([orderId])
}

model Invoice {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  number    String
  orderId   String?
  order     SalesOrder? @relation(fields: [orderId], references: [id])
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ownerId   String?
  owner     User?   @relation("InvoiceOwner", fields: [ownerId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // draft | sent | partial | paid | void
  status      String @default("draft")
  notes       String @default("")
  currency    String @default("USD")
  fxRateToBase Int @default(10000)
  taxCode     String @default("")
  subtotal    Int    @default(0)
  taxRate     Int    @default(0)
  taxAmount   Int    @default(0)
  total       Int    @default(0)
  amountPaid  Int    @default(0)
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?

  lines    InvoiceLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, dealId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Int @default(1)
  unitPrice   Int @default(0)
  lineTotal   Int @default(0)
  sortOrder   Int @default(0)

  @@index([invoiceId])
}

model Payment {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedById String?
  recordedBy   User? @relation("PaymentRecorder", fields: [recordedById], references: [id])

  amount      Int
  currency    String @default("USD")
  method      String @default("ach") // ach | card | check | wire | other
  reference   String @default("")
  notes       String @default("")
  receivedAt  DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([orgId, receivedAt])
  @@index([invoiceId])
}

model PurchaseOrder {
  id       String  @id @default(cuid())
  orgId    String
  org      Org     @relation(fields: [orgId], references: [id])
  number   String
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  ownerId  String?
  owner    User?   @relation("PoOwner", fields: [ownerId], references: [id])
  approvedById String?
  approvedBy   User? @relation("PoApprover", fields: [approvedById], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // draft | pending_approval | approved | submitted | partial | received | cancelled
  status    String @default("draft")
  notes     String @default("")
  currency  String @default("USD")
  fxRateToBase Int @default(10000)
  subtotal  Int    @default(0)
  taxRate   Int    @default(0)
  taxAmount Int    @default(0)
  total     Int    @default(0)
  orderedAt DateTime @default(now())
  approvedAt DateTime?
  receivedAt DateTime?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  vendorBills   VendorBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, vendorId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])

  description     String
  quantity        Int @default(1)
  qtyReceived     Int @default(0)
  unitCost        Int @default(0)
  lineTotal       Int @default(0)
  sortOrder       Int @default(0)

  @@index([purchaseOrderId])
}

// ---------- ERP deep: tax/FX, warehouses, GL, HR/projects, AP ----------

model TaxCode {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  code        String // US-CA, US-EXEMPT, EU-VAT-DE
  name        String
  ratePercent Int    @default(0) // whole percent
  jurisdiction String @default("")
  active      Boolean @default(true)

  @@unique([orgId, code])
}

model FxRate {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  currency    String // quote currency
  // Multiply quote amount by rate/10000 to get base currency
  rateToBase  Int
  asOf        DateTime @default(now())

  @@index([orgId, currency, asOf])
}

model Warehouse {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  code     String
  name     String
  address  String @default("")
  isDefault Boolean @default(false)
  active   Boolean @default(true)

  bins       WarehouseBin[]
  balances   InventoryBalance[]
  orders     SalesOrder[]
  purchaseOrders PurchaseOrder[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
}

model WarehouseBin {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  code String
  name String @default("")

  balances InventoryBalance[]

  @@unique([warehouseId, code])
}

model InventoryBalance {
  id          String  @id @default(cuid())
  orgId       String
  org         Org     @relation(fields: [orgId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  binId       String?
  bin         WarehouseBin? @relation(fields: [binId], references: [id])

  qtyOnHand   Int @default(0)
  qtyReserved Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([orgId, productId])
  @@index([orgId, warehouseId])
}

model StockTransfer {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  number String
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdById     String?
  createdBy       User? @relation("TransferUser", fields: [createdById], references: [id])

  // draft | posted
  status String @default("draft")
  notes  String @default("")
  postedAt DateTime?

  lines StockTransferLine[]

  createdAt DateTime @default(now())

  @@unique([orgId, number])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int @default(1)

  @@index([transferId])
}

model GlAccount {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  code String // 1000, 4000, etc.
  name String
  // asset | liability | equity | revenue | expense | cogs
  type String
  active Boolean @default(true)

  lines JournalLine[]

  @@unique([orgId, code])
  @@index([orgId, type])
}

model JournalEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  number String
  memo   String @default("")
  // invoice | payment | bill | receipt | manual | payroll
  sourceType String @default("manual")
  sourceId   String?
  currency   String @default("USD")
  postedById String?
  postedBy   User? @relation("JournalPoster", fields: [postedById], references: [id])
  postedAt   DateTime @default(now())

  lines JournalLine[]

  createdAt DateTime @default(now())

  @@unique([orgId, number])
  @@index([orgId, postedAt])
  @@index([orgId, sourceType, sourceId])
}

model JournalLine {
  id      String @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   GlAccount @relation(fields: [accountId], references: [id])

  memo    String @default("")
  debit   Int @default(0)  // base currency minor units (whole dollars in demo)
  credit  Int @default(0)

  @@index([entryId])
  @@index([accountId])
}

model Employee {
  id     String  @id @default(cuid())
  orgId  String
  org    Org     @relation(fields: [orgId], references: [id])
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  name       String
  email      String @default("")
  title      String @default("")
  department String @default("") // Sales | Engineering | Finance | Operations | People
  // full_time | contractor | part_time
  employmentType String @default("full_time")
  // active | terminated | leave
  status     String @default("active")
  hireDate   DateTime?
  // Annual salary whole dollars (or hourly * 2080 for contractors in demo)
  salaryAnnual Int @default(0)
  currency   String @default("USD")
  managerName String @default("")

  timeEntries TimeEntry[]
  projectsOwned Project[] @relation("ProjectManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, department])
  @@index([orgId, status])
}

model Project {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  code  String
  name  String
  // planning | active | on_hold | done
  status String @default("planning")
  dealId String?
  accountId String?
  ownerId String?
  owner   User? @relation("ProjectOwner", fields: [ownerId], references: [id])
  managerEmployeeId String?
  managerEmployee   Employee? @relation("ProjectManager", fields: [managerEmployeeId], references: [id])

  budgetHours Int @default(0)
  budgetAmount Int @default(0)
  currency String @default("USD")
  startDate DateTime?
  endDate   DateTime?
  notes     String @default("")

  tasks       ProjectTask[]
  timeEntries TimeEntry[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
  @@index([orgId, status])
}

model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  title       String
  // todo | doing | done
  status      String @default("todo")
  estimateHrs Int @default(0)
  sortOrder   Int @default(0)

  timeEntries TimeEntry[]

  @@index([projectId])
}

model TimeEntry {
  id         String @id @default(cuid())
  orgId      String
  org        Org    @relation(fields: [orgId], references: [id])
  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  taskId     String?
  task       ProjectTask? @relation(fields: [taskId], references: [id])
  userId     String?
  user       User? @relation("TimeEntryUser", fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  workDate   DateTime
  hours      Int @default(1) // whole hours for demo
  billable   Boolean @default(true)
  notes      String @default("")
  // draft | submitted | approved
  status     String @default("approved")

  createdAt DateTime @default(now())

  @@index([orgId, workDate])
  @@index([projectId, workDate])
}

model GoodsReceipt {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  number String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // draft | posted
  status String @default("posted")
  notes  String @default("")
  receivedAt DateTime @default(now())

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())

  @@unique([orgId, number])
  @@index([orgId, purchaseOrderId])
}

model GoodsReceiptLine {
  id             String @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  description    String @default("")
  quantity       Int @default(1)

  @@index([goodsReceiptId])
}

model VendorBill {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  number String
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // draft | open | partial | paid | void
  status String @default("open")
  currency String @default("USD")
  subtotal Int @default(0)
  taxAmount Int @default(0)
  total Int @default(0)
  amountPaid Int @default(0)
  issuedAt DateTime @default(now())
  dueAt DateTime?
  notes String @default("")

  lines VendorBillLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, vendorId])
}

model VendorBillLine {
  id          String @id @default(cuid())
  vendorBillId String
  vendorBill  VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int @default(1)
  unitCost    Int @default(0)
  lineTotal   Int @default(0)

  @@index([vendorBillId])
}

// ---------- Channels: employee email + phone connected for CRM outreach ----------
// Demo mode stores a connected address/number without real OAuth; production would
// swap provider tokens for Gmail/Outlook/Twilio/Aircall.

model ChannelConnection {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // EMAIL | PHONE
  channel  String
  // gmail | outlook | work_smtp | demo_email | twilio | aircall | ringcentral | demo_phone
  provider String
  // Email address or E.164 phone number shown as the "from"
  address  String
  // CONNECTED | DISCONNECTED | ERROR
  status   String @default("CONNECTED")
  // Opaque token blob for real providers (JSON string). Demo stores "{}".
  credentialsJson String @default("{}")
  lastError       String @default("")

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, channel])
  @@index([orgId, userId])
}

// A thread of emails or a phone conversation attached to CRM records.
model Conversation {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id])
  ownerId   String
  owner     User    @relation("ConversationOwner", fields: [ownerId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  // EMAIL | PHONE
  channel String
  subject String @default("")
  // OPEN | CLOSED
  status  String @default("OPEN")
  // Prospect-facing address/number for this thread
  prospectAddress String @default("")

  messages Message[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([orgId, dealId, lastMessageAt])
  @@index([orgId, contactId, lastMessageAt])
  @@index([orgId, ownerId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])
  // Optional link when a PHONE message was graded as a SalesCoach call
  callId         String?
  call           Call?        @relation(fields: [callId], references: [id])

  // OUTBOUND | INBOUND
  direction String
  // For email: subject line of this message; for phone: "Outbound call" etc.
  subject   String @default("")
  body      String @default("")
  // queued | sent | delivered | failed | received | completed
  status    String @default("sent")
  // From/to for audit (employee connected address ↔ prospect)
  fromAddress String @default("")
  toAddress   String @default("")
  durationSec Int?
  externalId  String?

  grade Grade?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([conversationId, occurredAt])
  @@index([orgId, occurredAt])
}

model Transcript {
  id     String @id @default(cuid())
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  // JSON: TranscriptSegment[] ({ speaker: "rep"|"prospect", startSec, endSec, text })
  segmentsJson String
  fullText     String
  engine       String @default("mock") // deepgram | whisper | provided | mock

  createdAt DateTime @default(now())
}

model Scenario {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  title       String
  callType    String @default("discovery")
  difficulty  String @default("medium") // easy | medium | hard
  // JSON: ScenarioPersona (src/lib/types.ts)
  personaJson String
  // JSON: string[] — what a winning conversation accomplishes
  winConditionsJson String @default("[]")

  methodologyId String?
  methodology   Methodology? @relation(fields: [methodologyId], references: [id])

  roleplays   RoleplaySession[]
  assignments Assignment[]

  createdAt DateTime @default(now())
}

model RoleplaySession {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  repId String
  rep   User   @relation(fields: [repId], references: [id])

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  mode   String @default("TEXT") // TEXT | VOICE
  status String @default("ACTIVE") // ACTIVE | COMPLETED | GRADED | FAILED
  // JSON: RoleplayMessage[] ({ role: "rep"|"prospect", text, atMs })
  messagesJson String @default("[]")
  vapiCallId   String?
  durationSec  Int    @default(0)

  grade Grade?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([orgId, repId, startedAt])
}

model Grade {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  subjectType String // CALL | ROLEPLAY | EMAIL
  callId      String? @unique
  call        Call?   @relation(fields: [callId], references: [id])
  roleplayId  String? @unique
  roleplay    RoleplaySession? @relation(fields: [roleplayId], references: [id])
  messageId   String? @unique
  message     Message? @relation(fields: [messageId], references: [id])

  methodologyId String
  methodology   Methodology @relation(fields: [methodologyId], references: [id])

  // JSON: DimensionScore[] ({ key, score 1..5, rationale, quotes })
  dimensionScoresJson String
  overallScore        Int // 0..100, weighted rollup — see src/lib/scoring.ts
  band                String // exceptional | strong | developing | needs_coaching
  // JSON: string[]
  strengthsJson    String @default("[]")
  improvementsJson String @default("[]")
  summary          String @default("")
  // JSON: Mechanics ({ talkRatio, questionCount, longestMonologueSec, fillerWords, interruptions })
  mechanicsJson String @default("{}")
  gradedBy      String @default("mock") // model id, or "mock"

  // Manager calibration layer
  managerOverrideScore Int?
  managerComment       String?

  createdAt DateTime @default(now())

  @@index([orgId, subjectType, createdAt])
}

model Assignment {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  type        String // ROLEPLAY | UPLOAD_CALLS
  scenarioId  String?
  scenario    Scenario? @relation(fields: [scenarioId], references: [id])
  targetCount Int       @default(1)
  doneCount   Int       @default(0)
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, assignedToId, status])
}

// Webhook payloads that couldn't be mapped to a known rep email.
model UnmatchedIngest {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  // WEBHOOK | CRM_SYNC
  source       String
  repEmail     String
  externalId   String?
  payloadJson  String
  // PENDING | RESOLVED | DISMISSED
  status       String  @default("PENDING")
  resolvedRepId String?
  resolvedBy   User?   @relation("UnmatchedResolver", fields: [resolvedRepId], references: [id])
  resolvedCallId String?
  note         String  @default("")

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([orgId, status, createdAt])
  @@unique([orgId, source, externalId])
}

// Durable job queue (SQLite/Postgres). Workers claim PENDING rows.
// Production can swap the poller for BullMQ/SQS without changing job names.
model Job {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  // PROCESS_CALL | GRADE_ROLEPLAY | GRADE_EMAIL | RETENTION_SWEEP
  type        String
  // PENDING | RUNNING | DONE | FAILED
  status      String @default("PENDING")
  payloadJson String @default("{}")
  attempts    Int    @default(0)
  lastError   String @default("")
  runAfter    DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, runAfter])
  @@index([orgId, type, status])
}

// Append-only audit trail for platform-console actions (org creation, user
// maintenance, impersonation, PII reveals, queue ops). The application exposes
// no update or delete path for these rows — treat as immutable. orgId is a
// plain string (no FK) so audit rows survive tenant deletion.
model AuditEvent {
  id          String  @id @default(cuid())
  actorId     String?
  actorEmail  String
  consoleRole String  @default("")
  // e.g. ORG_CREATED | USER_CREATED | USER_PASSWORD_RESET | USER_ROLE_CHANGED |
  //      JOB_RETRIED | JOBS_DRAINED | PRESETS_INSTALLED | CONSOLE_ELEVATED |
  //      CONSOLE_ELEVATION_DENIED | IMPERSONATION_STARTED | IMPERSONATION_ENDED |
  //      PII_REVEALED
  action     String
  targetType String  @default("")
  targetId   String?
  orgId      String?
  ip         String  @default("")
  metaJson   String  @default("{}")
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// Billable usage events for metering / future Stripe integration.
model UsageEvent {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id])
  userId String?

  // CALL_GRADED | ROLEPLAY_GRADED | EMAIL_GRADED | ASK_QUERY | VOICE_SESSION | ...
  type        String
  quantity    Int    @default(1)
  subjectType String @default("")
  subjectId   String?
  metaJson    String @default("{}")

  createdAt DateTime @default(now())

  @@index([orgId, type, createdAt])
  @@index([orgId, createdAt])
}
