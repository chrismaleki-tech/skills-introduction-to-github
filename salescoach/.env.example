# Required — PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
DATABASE_URL="postgresql://salescoach:salescoach@127.0.0.1:5432/salescoach"

# Clerk auth (required for production signup). When unset, demo cookie auth is used.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# CLERK_WEBHOOK_SECRET=whsec_...

# Durable audio storage (S3 or Cloudflare R2). When unset, uses local ./uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional — real AI grading + role-play when set; deterministic demo engines otherwise.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional — real audio transcription with diarization when set.
# DEEPGRAM_API_KEY=
# VAPI_WEBHOOK_SECRET=
# ADMIN_EMAILS=you@example.com

# Stripe subscriptions (per-seat Pro and Max plans)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_MAX_PRICE_ID=price_...
# STRIPE_PRICE_ID=price_... # Legacy fallback for Pro
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production operations. Use separate random values of at least 32 bytes.
# OPS_SECRET=
# CRON_SECRET=
# ALERT_WEBHOOK_URL= # Optional Slack-compatible operations alert webhook
