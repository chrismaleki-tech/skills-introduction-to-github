DATABASE_URL="file:./dev.db"

# --- Required in production ---
# SESSION_SECRET=  # openssl rand -base64 48
# ALLOW_DEMO_SWITCHER=false
# APP_BASE_URL=https://your.domain

# Auth — demo switcher defaults on in development only.
# ALLOW_DEMO_SWITCHER=true
# INLINE_JOBS=true
# PLATFORM_ADMIN_EMAILS=you@company.com

# Job worker (npm run jobs:worker)
# JOB_POLL_MS=2000
# JOB_BATCH_SIZE=10
# RETENTION_CRON_HOURS=24

# Optional — real AI grading + role-play when set; deterministic demo engines otherwise.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional — real audio transcription with diarization when set.
# DEEPGRAM_API_KEY=
# Optional — voice role-play via Vapi web calls.
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
# VAPI_ASSISTANT_ID=
# VAPI_VOICE_ID=rachel
# VAPI_SERVER_URL=   # defaults to APP_BASE_URL + /api/vapi/webhook

# Object storage (S3-compatible). Without these, audio stays on local disk.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=       # optional MinIO/R2 endpoint

# Live email / phone channels
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=587
# SMTP_RELAY_URL=    # optional HTTP relay that accepts {from,to,subject,text}
# SMTP_RELAY_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TWIML_URL=
# AIRCALL_API_ID=
# AIRCALL_API_TOKEN=
# RINGCENTRAL_CLIENT_ID=
# RINGCENTRAL_CLIENT_SECRET=
