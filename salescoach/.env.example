# Required — PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
DATABASE_URL="postgresql://salescoach:salescoach@127.0.0.1:5432/salescoach"

# Clerk auth (required for production signup). When unset, demo cookie auth is used.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Durable audio storage (S3 or Cloudflare R2). When unset, uses local ./uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional — real AI grading + role-play when set; deterministic demo engines otherwise.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional — real audio transcription with diarization when set.
# DEEPGRAM_API_KEY=
# ADMIN_EMAILS=you@example.com
# CLERK_WEBHOOK_SECRET=whsec_...

# Stripe subscriptions ($50/month flat organization plan)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=http://localhost:3000
