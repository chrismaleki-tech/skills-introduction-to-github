# Environment Configuration for Rearc Data Quest
# Copy this file to .env and update with your actual values

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# CDK Configuration
CDK_DEFAULT_REGION=us-east-2
CDK_DEFAULT_ACCOUNT=your-aws-account-id

# Application Configuration
PYTHON_VERSION=3.9
NODE_VERSION=18

# S3 Bucket Names (will be created by CDK)
BLS_BUCKET_NAME=rearc-quest-bls-data
POPULATION_BUCKET_NAME=rearc-quest-population-data

# Lambda Configuration
LAMBDA_TIMEOUT=300
LAMBDA_MEMORY=512

# SQS Configuration
SQS_VISIBILITY_TIMEOUT=300

# CloudWatch Configuration
LOG_RETENTION_DAYS=7

# Development Settings
DEBUG=false
ENVIRONMENT=dev

# Data Golf API (https://datagolf.com) - requires Scratch Plus membership.
# Used by datagolf/update_csv.py and the sportsdata MCP server (.cursor/mcp.json).
DATAGOLF_KEY=

# WordPress (statcaddygolf.com) — used by datagolf/load_wordpress.py and
# datagolf/deploy_simulator.py (weekly member-simulator deploy).
# For a SiteGround staging copy, set WP_URL to https://staging1.statcaddygolf.com
# (see wordpress/STAGING.md). GitHub Actions uses WP_STAGING_URL for target=staging.
WP_URL=
WP_USERNAME=
# Real account password for /golflogin (Playwright admin deploy). Required by
# Weekly Simulator Deploy. Do NOT put an Application Password here.
WP_PASSWORD=
# Application Password for REST API only (Users -> Profile -> Application Passwords).
WP_APP_PASSWORD=
